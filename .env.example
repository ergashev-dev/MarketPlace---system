# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/marketplace"

# Auth
JWT_SECRET=change-me
# Token muddati: "15m", "1d", "7d" yoki soniyalarda raqam ("3600"). Default: 1d
JWT_EXPIRES_IN=1d
# Shu email bilan ro'yxatdan o'tgan yoki shu email'li user avtomatik ADMIN bo'ladi
ADMIN_EMAIL=admin@example.com

# CORS: ruxsat etilgan origin'lar, vergul bilan. Bo'sh bo'lsa:
# development'da hammasi, production'da hech biri ruxsat etilmaydi
CORS_ORIGINS=http://localhost:5173,https://example.uz

# Reverse proxy (nginx) ortida bo'lsa, throttler haqiqiy IP'ni ko'rishi uchun
# proxy'lar soni (odatda 1). Proxy'siz ishlasa bo'sh qoldiring.
TRUST_PROXY=

# Seed (npx prisma db seed): birinchi ADMIN. Parolni repo'ga qo'ymang!
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
