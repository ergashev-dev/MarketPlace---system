// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              Int       @id @default(autoincrement())
  fullName        String
  email           String    @unique
  passwordHash    String
  phone           String?
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  blockedAt       DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())

  properties        Property[]
  favorites         Favorite[]
  inquiries         Inquiry[]
  reports           Report[]
  emailVerification EmailVerification?
  notifications     Notification[]
  auditLogs         AuditLog[]
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  properties Property[]
}

model Property {
  id                   Int            @id @default(autoincrement())
  title                String
  description          String
  price                Float
  currency             String         @default("USD")
  listingType          ListingType
  status               PropertyStatus @default(PENDING)
  address              String
  city                 String
  area                 Float
  rooms                Int
  bathrooms            Int
  rejectReason         String?
  lat                  Float?
  lng                  Float?
  viewCount            Int            @default(0)
  closedAt             DateTime?
  expiryReminderSentAt DateTime?
  expiresAt            DateTime?
  createdAt            DateTime       @default(now())

  ownerId    Int
  owner      User     @relation(fields: [ownerId], references: [id])
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  images     PropertyImage[]
  favorites  Favorite[]
  inquiries  Inquiry[]
  reports    Report[]
  viewsDaily PropertyViewDaily[]
}

model PropertyImage {
  id        Int     @id @default(autoincrement())
  url       String
  altText   String?
  sortOrder Int     @default(0)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Inquiry {
  id        Int       @id @default(autoincrement())
  message   String
  phone     String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  senderId   Int
  sender     User     @relation(fields: [senderId], references: [id])
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Report {
  id        Int      @id @default(autoincrement())
  reason    String
  message   String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User     @relation(fields: [reporterId], references: [id])

  @@unique([reporterId, propertyId])
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  sentAt    DateTime @default(now())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int       @id @default(autoincrement())
  type      String
  text      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  targetType String
  targetId   Int?
  details    String?
  createdAt  DateTime @default(now())

  adminId Int?
  admin   User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model PropertyViewDaily {
  id    Int      @id @default(autoincrement())
  day   DateTime @db.Date
  count Int      @default(0)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, day])
}
